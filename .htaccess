# ==========================================================================
#  .htaccess — Apache 2.4
#  Кэш, сжатие, заголовки безопасности, запрет служебных файлов.
#  Хеш встроенного скрипта в CSP пересчитывает build.sh — руками не править.
# ==========================================================================

AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .xml .txt

Options -Indexes

# Своя страница ошибки: путь от корня, она открывается по любому адресу
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/x-icon .ico
  AddType text/javascript .js
</IfModule>


# ----- HTTPS, без www, без /index.html -----
# Один канонический адрес — иначе поисковик считает дублями
# http/https, www/без www и / и /index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # X-Forwarded-Proto — для хостингов, где TLS снимает прокси перед Apache
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
</IfModule>


# ----- Служебные файлы не отдаём -----
# Скрипты сборки, заметки, исходники фото (в них EXIF с геометкой),
# git и редакторские файлы. 404, а не 403: незачем подтверждать,
# что такие файлы вообще есть.
RedirectMatch 404 /\.(git|svn|vscode|idea)(/|$)
RedirectMatch 404 /assets/img/src(/|$)
RedirectMatch 404 /assets/img/docs/src(/|$)
RedirectMatch 404 /assets/content(/|$)
RedirectMatch 404 /(tools|dist)(/|$)
RedirectMatch 404 /node_modules(/|$)

<FilesMatch "(^\.|\.(sh|md|cjs|mjs|map|log|bak|orig|swp|lock)$|^package(-lock)?\.json$)">
  Require all denied
</FilesMatch>


# ----- Сжатие -----
# woff2, webp и jpg уже сжаты — повторно их не трогаем.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml image/x-icon
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml image/x-icon
</IfModule>


# ----- Кэш -----
# CSS и JS подключены с ?v=N, шрифты не меняются — им год и immutable.
# Фото — месяц: имена файлов постоянные (hero-1000.webp), и после замены
# снимка посетители должны увидеть новый без смены разметки.
# HTML — всегда сверяется с сервером, чтобы правки текста доходили сразу.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/avif                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|png|jpe?g|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>


  # ----- Безопасность -----
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # HSTS — включить, когда HTTPS на домене точно настроен: браузер запомнит
  # правило на год, и откатиться на http будет нельзя.
  # Header always set Strict-Transport-Security "max-age=31536000"

  # CSP: всё своё, кроме Яндекса. Метрика — скрипт и запросы к mc.yandex.ru
  # (загружается только после согласия на cookie); iframe карты и виджета
  # отзывов — yandex.ru (yandex.com — на случай редиректа для зарубежных
  # посетителей). Встроенный скрипт разрешён только по хешу; 'unsafe-inline'
  # в style-src — для стилей, которые вставляет код Метрики.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-JHLQDXsf4Mz+I+MCgIVFeKJgsXh/Z4uU1wCoyf0KG6Q=' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; font-src 'self'; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; frame-src https://yandex.ru https://*.yandex.ru https://yandex.com https://*.yandex.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
